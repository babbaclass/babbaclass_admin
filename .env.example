# GCP 프로젝트 설정
PROJECT_ID=astute-window-472313-g9
REGION=asia-northeast3

# GCP 인증 (선택사항)
# 서비스 계정 키 파일 경로를 지정하면 gcloud auth application-default login 없이도 인증 가능
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Artifact Registry 설정
REGISTRY=asia-northeast3-docker.pkg.dev
REPO_NAME=babba-registry

# 서비스 및 이미지 설정
SERVICE_NAME=babba-api
IMAGE_NAME=babba-api
IMAGE_TAG=latest

# Cloud Run 리소스 설정 (선택사항)
MEMORY=512Mi
CPU=1
MAX_INSTANCES=100
MIN_INSTANCES=0

# MakeShop API 인증 정보 (구 Open API — 코드 유지, 기본 미사용. 롤백 시에만 필요)
# 실제 값을 로컬 .env 또는 배포용 Secret Manager 에서 주입하세요.
MAKESHOP_SHOPKEY=ba9e9e655550c14ab3fc6d778bcba33b
MAKESHOP_LICENSEKEY=Yzg3MGRmM2ZiYzRhNmU2MmE1MTU0NzAyNjlmZGY4MTQ=
MAKESHOP_API_URL=www.babbasmartclass.com
MAKESHOP_API_TIMEOUT=10

# MakeShop REST API (Developer Center) — 기본 사용 경로
# 로컬: 아래 값을 .env 에 설정
# 배포(필수): GitHub Actions Secrets → MAKESHOP_CLIENT_ID, MAKESHOP_CLIENT_SECRET, MAKESHOP_SHOP_UID
#   (APP 설치 HMAC/온보딩용. shop_uid 는 설치 콜백에도 전달됨)
# MAKESHOP_USE_REST 기본 true. 구 Open API는 코드만 유지, 긴급 롤백 시에만 false
# MAKESHOP_SHOP_UID 미설정 시 makeshop_installed_apps 최신 shop_uid 사용
# MAKESHOP_CLIENT_ID=your_client_id
# MAKESHOP_CLIENT_SECRET=your_client_secret
# MAKESHOP_SHOP_UID=babbaclass
# MAKESHOP_USE_REST=true
# MAKESHOP_REST_BASE_URL=https://connect.makeshop.co.kr  # 미설정 시 이 기본값 사용
# APP URL (개발자센터 > 개발 정보 관리): https://<host>/makeshop/install
# Docs: https://developer.makeshop.co.kr/docs/guide/app/install

# Google Chat
# GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/.../messages?key=...&token=...
# MAKESHOP_REST_CHAT_NOTIFY=true             # 마스터 (실패 즉시 + sync 종료 요약)
# MAKESHOP_REST_CHAT_NOTIFY_SUCCESS=         # 비우면 자동: sync 중 성공=요약만 / sync 밖 POST 성공=즉시
#                                            # true면 성공도 호출마다 Chat, false면 성공 Chat 전부 off
# sync 종료 요약: REST 성공/실패 건수·path별 내역·실패 샘플
# 실패는 sync 중이어도 즉시 Chat

# 병행 비교 (기본 off — Chat 미전송). 재활성 시에만 true
# MAKESHOP_DUAL_COMPARE=false
# MAKESHOP_DUAL_COMPARE_EVERY_PAGE=true
# MAKESHOP_DUAL_COMPARE_CHAT_ON_MATCH=true

# Cloud SQL 설정
# 주의: 보안을 위해 전용 애플리케이션 계정 사용을 권장합니다 (예: DB_USER=babba_app).
#       루트 원격 접근(Plan B)은 사용하지 않습니다.
CLOUD_SQL_INSTANCE=astute-window-472313-g9:asia-northeast3:babba-db
CLOUD_SQL_HOST=34.22.93.96
DB_USER=babba_app
DB_PASSWORD=Fulfilled07!
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=babba
DB_SSL_MODE=DISABLED

# FastAPI 설정
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
